  },
  "rules": {
    "_purpose": "Architectural invariants the agent must enforce — checked before any code generation",
    "no-material-theme-extension": {
      "scope": "**/*.kt",
      "rule": "Never extend MaterialTheme. FinsibleTheme wraps it."
    },
    "composition-local-only": {
      "scope": "ui/component/templates/**",
      "rule": "Tokens via CompositionLocal / FinsibleTheme object only — never pass tokens as params."
    },
    "flat-template-packages": {
      "scope": "ui/component/templates/**",
      "rule": "No per-component subfolders. Flat 6-package layout: component/core/default/model/preview/util."
    },
    "no-preview-in-main": {
      "scope": "ui/component/templates/**",
      "rule": "@Preview only in preview/ package — never in component/ or default/."
    },
    "playground-debug-only": {
      "scope": "ui/screen/playground/**",
      "rule": "Playground files live in debug source set only — never main."
    },
    "immutable-collections-in-state": {
      "scope": "ui/viewmodel/**",
      "rule": "All StateFlow<T> where T contains collections must use ImmutableList/ImmutableMap."
    },
    "io-dispatcher-for-db": {
      "scope": "ui/viewmodel/**",
      "rule": "DB/network calls inside withContext(Dispatchers.IO). State updates on Main."
    },
    "gate-before-write": {
      "scope": "**",
      "rule": "No file writes without /approve. All writes staged via gate extension."
    }
  }
}